{
  "expo": {
    "name": "Qwalla",
    "slug": "Qwalla",
    "version": "1.2.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "qwalla",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0C10"
    },
    "ios": {
      "bundleIdentifier": "io.qwalla.app",
      "supportsTablet": false,
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSCameraUsageDescription": "Qwalla uses the camera to scan QR codes for wallet addresses and dApp connections.",
        "NSPhotoLibraryUsageDescription": "Qwalla uses your photo library to attach images to messages, mail, and token logos.",
        "NSFaceIDUsageDescription": "Qwalla uses Face ID to unlock your wallet."
      },
      "buildNumber": "32"
    },
    "android": {
      "package": "io.qwalla.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0A0C10",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE"
      ],
      "predictiveBackGestureEnabled": false,
      "versionCode": 8
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#1FE0C5",
          "sounds": []
        }
      ],
      "expo-sharing",
      "react-native-quick-crypto",
      [
        "expo-audio",
        {
          "microphonePermission": "Qwalla uses the microphone to record voice notes in chats."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.margelo.** { *; }\n-dontwarn com.margelo.**\n-keep @com.facebook.proguard.annotations.DoNotStrip class *\n-keepclassmembers class * { @com.facebook.proguard.annotations.DoNotStrip *; }\n-keepclasseswithmembernames class * { native <methods>; }\n-keep class io.qwalla.app.** { *; }"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "17b68669-78ac-452f-bc20-d501f0eadf9c"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/17b68669-78ac-452f-bc20-d501f0eadf9c"
    }
  }
}
