# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Local Netlify folder
.netlify

# build artifacts / scratch (EAS builds, release-upload helpers)
*.apk
*.aab
build.json

# Electron desktop installers output (desktop/node_modules covered by node_modules/)
desktop/release/
desktop/release-browser/

# EAS Update code-signing PRIVATE key material — NEVER commit.
keys/
*private-key*.pem
# ...but the PUBLIC code-signing certificate MUST be committed: the build embeds
# it (app.json updates.codeSigningCertificate) so the client verifies updates.
# This exception overrides the broad `*.pem` rule above.
!certs/certificate.pem
