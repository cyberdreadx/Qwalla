{
  "name": "qwalla-desktop",
  "version": "1.2.0",
  "description": "Qwalla desktop — an Electron shell around the Expo web build (macOS + Windows).",
  "private": true,
  "author": "Qwalla",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:browser": "electron main-browser.js",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:all": "electron-builder -mw",
    "dist:browser:win": "electron-builder --win --config electron-builder-browser.json",
    "dist:browser:mac": "electron-builder --mac --config electron-builder-browser.json"
  },
  "dependencies": {
    "serve-handler": "^6.1.6"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "io.qwalla.desktop",
    "productName": "Qwalla",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "webview-preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "web"
      }
    ],
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        {
          "target": "dmg",
          "arch": "universal"
        }
      ],
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "dmg": {
      "artifactName": "Qwalla-macOS-${version}.dmg"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
